# Local dev Postgres started by the root docker-compose.yml.
# Copy to `.env` (same directory) and adjust if you change the compose defaults.
DATABASE_URL="postgresql://hated:hated@localhost:5432/hated?schema=public"

# Transactional email for institution verification codes.
# The transport is picked automatically: SMTP when SMTP_HOST is set, else Resend
# when RESEND_API_KEY is set, else the console mailer (prints the code).
# Force one with MAIL_TRANSPORT=smtp|resend|console.
MAIL_TRANSPORT=""
# Sender. Must be verified with whichever provider sends.
MAIL_FROM="HateD <onboarding@resend.dev>"

# Resend (HTTP API).
RESEND_API_KEY=""

# SMTP relay, e.g. Brevo: host smtp-relay.brevo.com, port 587 (STARTTLS).
# SMTP_USER is the relay login and SMTP_PASS an SMTP key from the provider's
# dashboard, not your account password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# "true" for implicit TLS. Defaults to true only on port 465.
SMTP_SECURE=""
