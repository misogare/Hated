{
  "name": "@hated/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HateD persistence layer: Prisma schema and typed client for profiles, questionnaires, match rounds, and .edu/.gov verification.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "prisma db seed",
    "round": "tsx src/cli.ts",
    "round:inspect": "tsx src/inspect.ts",
    "compare": "tsx src/compare.ts",
    "studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hated/core": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
