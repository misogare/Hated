# Copy to `.env` in this directory. The database URL and mail settings are
# read from packages/db/.env, so only API-specific settings live here.

# Where to listen. 0.0.0.0 lets a phone on the same Wi-Fi reach the API.
PORT="3000"
HOST="0.0.0.0"

# When rounds close: a weekday, a 24-hour time, and an IANA time zone.
ROUND_DAY="SUN"
ROUND_TIME="20:00"
ROUND_TIMEZONE="Australia/Melbourne"
# The API runs each round itself when its slot arrives (and catches up a slot
# missed within the last 12 hours). Set to "false" to run rounds by hand only.
ROUND_AUTORUN="true"

# Behind a reverse proxy (most hosts), set to "true" so the per-IP limits on
# sign-in see each caller's address (X-Forwarded-For) instead of the proxy's.
TRUST_PROXY="false"

# Push notifications go through Expo's push service. Only needed if "enhanced
# push security" is switched on for the Expo project (expo.dev > project >
# Credentials); create the token at expo.dev > Account settings > Access tokens.
EXPO_ACCESS_TOKEN=""
