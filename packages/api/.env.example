# Copy to `.env` in this directory. The database URL and mail settings are
# read from packages/db/.env, so only API-specific settings live here.

# HMAC key for session tokens, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=""

# Where to listen. 0.0.0.0 lets a phone on the same Wi-Fi reach the API.
PORT="3000"
HOST="0.0.0.0"

# When rounds close: a weekday, a 24-hour time, and an IANA time zone.
ROUND_DAY="SUN"
ROUND_TIME="20:00"
ROUND_TIMEZONE="Australia/Melbourne"
