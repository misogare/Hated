{
  "name": "@hated/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HateD matching engine: FirstDate preference ranking + orientation-aware Gale-Shapley stable matching with a rotation-lattice fairness search.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "fast-check": "^3.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
