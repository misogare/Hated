{
  "name": "hated",
  "version": "0.1.0",
  "private": true,
  "description": "HateD - one-shot stable-match dating. Monorepo root.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "sim": "npm run sim -w @hated/core --",
    "db:generate": "npm run generate -w @hated/db",
    "db:migrate": "npm run migrate -w @hated/db --",
    "round": "npm run round -w @hated/db --",
    "round:inspect": "npm run round:inspect -w @hated/db --"
  },
  "engines": {
    "node": ">=20"
  }
}
