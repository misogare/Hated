{
  "name": "hated",
  "version": "0.1.0",
  "private": true,
  "description": "HateD - one-shot stable-match dating. Monorepo root.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --emitDeclarationOnly && npm run typecheck -w @hated/mobile",
    "sim": "npm run sim -w @hated/core --",
    "db:generate": "npm run generate -w @hated/db",
    "db:migrate": "npm run migrate -w @hated/db --",
    "seed:demo": "npm run seed:demo -w @hated/db --",
    "reports": "npm run reports -w @hated/db --",
    "round": "npm run round -w @hated/db --",
    "round:inspect": "npm run round:inspect -w @hated/db --",
    "compare": "npm run compare -w @hated/db --",
    "send-code": "npm run send-code -w @hated/db --",
    "verify-code": "npm run verify-code -w @hated/db --",
    "mail:check": "npm run mail:check -w @hated/db --",
    "api": "npm run dev -w @hated/api",
    "mobile": "npm start -w @hated/mobile",
    "demo": "npm run demo -w @hated/mobile"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
